# Core service — defaults are safe for local use.
APP_HOST=127.0.0.1
APP_PORT=3000
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
SCHEDULER_ENABLED=true
DEMO_ENABLED=true
STORE_RAW_RESUME=false

# Optional path overrides; uncomment and use absolute paths when needed.
# APP_DATA_DIR=/absolute/path/to/data
# APP_WEB_DIR=/absolute/path/to/web

# DeepSeek (optional AI enhancement)
# Legacy deepseek-chat/reasoner names were retired on 2026-07-24.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_TIMEOUT_SECONDS=45

# Google Jobs aggregation through SerpAPI (optional)
SERPAPI_KEY=

# Daily email digest (optional; credentials stay server-side)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# MCP server (optional)
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Security and capacity
ALLOWED_ORIGINS=
MAX_REQUEST_BYTES=6291456
RATE_LIMIT_PER_MINUTE=120
MAX_CONCURRENT_REQUESTS=24
